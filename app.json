{
  "expo": {
    "name": "Bubbie",
    "slug": "bubbie",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bubbie",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F5F1",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.bubbie.run",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Bubbie reads your runs, heart rate and workouts to shape your plan and fueling.",
        "NSHealthUpdateUsageDescription": "Bubbie writes nutrition you log so it shows up in Apple Health.",
        "NSCameraUsageDescription": "Bubbie uses the camera to log a meal from a photo.",
        "NSPhotoLibraryUsageDescription": "Bubbie can log a meal from a photo in your library.",
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "associatedDomains": []
    },
    "android": {
      "package": "app.bubbie.run",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F5F1"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bubbie"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Bubbie",
      "shortName": "Bubbie",
      "themeColor": "#F6F5F1",
      "backgroundColor": "#F6F5F1",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F6F5F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "google": {
        "expoClientId": "",
        "iosClientId": "",
        "androidClientId": "",
        "webClientId": ""
      }
    }
  }
}
